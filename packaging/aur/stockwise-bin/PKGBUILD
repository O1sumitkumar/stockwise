#: Template: packaging/render.sh fills @VERSION@ and the checksums from the
#: release's Linux .sha256 files, and drops these #: lines.
# Maintainer: iamsaquib8 <saquibulhassan6@gmail.com>

pkgname=stockwise-bin
_name=stockwise
pkgver=@VERSION@
pkgrel=1
pkgdesc="Stock market toolkit for your terminal: Indian (NSE/BSE) and US stocks"
arch=('x86_64' 'aarch64')
url="https://github.com/iamsaquib8/stockwise"
license=('MIT')
depends=('glibc' 'libgcc')
provides=("$_name")
conflicts=("$_name")
options=('!debug')
source_x86_64=("$_name-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/$_name-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$_name-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/$_name-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64_UNKNOWN_LINUX_GNU@')
sha256sums_aarch64=('@SHA256_AARCH64_UNKNOWN_LINUX_GNU@')

package() {
  cd "$_name-$CARCH-unknown-linux-gnu"
  install -Dm755 "$_name" "$pkgdir/usr/bin/$_name"
  install -Dm644 man/*.1 -t "$pkgdir/usr/share/man/man1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md DISCLAIMER.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"

  ./"$_name" completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/$_name"
  ./"$_name" completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_$_name"
  ./"$_name" completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/$_name.fish"
}
